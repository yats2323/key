# Copy to .env for local testing; set these as environment variables on your host.
PORT=3000
PUBLIC_BASE_URL=https://YOUR-HOST.example
DISCORD_BOT_TOKEN=replace_me
DISCORD_CLIENT_ID=replace_me
DISCORD_GUILD_ID=replace_me
ADMIN_API_TOKEN=generate_a_long_random_secret
# Keep the existing RSA private key XML here on the server only. Never put it in VideoClipper.
LICENSE_PRIVATE_XML=PASTE_EXISTING_RSA_PRIVATE_XML_HERE
# Optional JSON file path. Use persistent disk storage on your host.
DATA_FILE=/var/data/licenses.json
